# ============================================================
#  OoverrFinancee — шаблон переменных окружения
# ============================================================
#  СКОПИРУЙ этот файл в ".env" и заполни значениями.
#  Файл ".env" НИКОГДА не коммитится (см. .gitignore) и никому не отправляется.
# ============================================================

# ---------- Supabase (PostgreSQL + Auth + Realtime) ----------
# Взять в Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# ВНИМАНИЕ: service_role — СЕКРЕТНЫЙ ключ. Используется ТОЛЬКО сервером бота.
# Никогда не попадает в браузер и не коммитится.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Google Gemini (LLM-парсер + распознавание голоса) ----------
# Ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash

# ---------- Telegram-бот ----------
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Два Telegram ID (числа через запятую), кому разрешено пользоваться ботом.
# Узнать свой ID можно у @userinfobot
ALLOWED_TELEGRAM_IDS=

# ---------- Общие настройки ----------
TZ=Europe/Kyiv
LOG_LEVEL=info
